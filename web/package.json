{
  "name": "atommap-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AtomMap UI (Vite and TypeScript, static build).",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-site.mjs",
    "smoke": "node scripts/smoke.mjs",
    "record-results": "node scripts/record-results.mjs",
    "measure-limit": "node scripts/measure-limit.mjs",
    "check-maps": "node scripts/check-maps.mjs",
    "layout-check": "node scripts/layout-check.mjs",
    "check": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "fast-check": "4.10.3",
    "playwright": "1.65.1",
    "typescript": "5.6.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
